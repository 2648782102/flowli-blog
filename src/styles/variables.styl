// B 杂志网格配色 — 与 src/styles/editorial.css 保持一致。
// 本文件是历史遗留的 Stylus 变量表，当前构建不直接引用，保留以维护与
// 旧工具链的兼容性；真实生效的令牌定义在 editorial.css 的 :root 中。

white(a)
    rgba(255, 255, 255, a)

black(a)
    rgba(0, 0, 0, a)

:root
    --radius-large 2px

define(vars)
    :root
        for key, value in vars
            {key}: value[0]
    :root.dark
        for key, value in vars
            if length(value) > 1
                {key}: value[1]

define({
    --primary: #a8342a #e87e66
    --page-bg: #f7f4ec #16150f
    --card-bg: #fdfbf6 #1e1c16
    --card-bg-transparent: #fdfbf6 #1e1c16
    --btn-content: #1c1a17 #ece6d8
    --btn-regular-bg: #efe9dc #27241c
    --btn-regular-bg-hover: #f1e0d9 #3a2620
    --deep-text: #1c1a17 #ece6d8
    --title-active: #7c2314 #f19c87
    --line-divider: #d9d2c3 #363229
    --line-color: #d9d2c3 #363229
    --meta-divider: #c2b9a5 #4c4638
    --content-meta: #514c43 #bcb5a5
    --inline-code-bg: #efe9dc #27241c
    --inline-code-color: #7c2314 #f19c87
    --selection-bg: #ecd3c8 #4a2c24
    --codeblock-bg: #efe9dc #27241c
    --float-panel-bg: #fdfbf6 #1e1c16
    --toc-badge-bg: #efe9dc #27241c
    --toc-item-active: #a8342a #e87e66
})
