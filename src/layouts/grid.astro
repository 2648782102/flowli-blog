---
import type { MarkdownHeading } from "astro";

import { widgetManager } from "@utils/widget";
import Sidebar from "@components/sidebar.astro";
import BaseLayout from "./base.astro";
import { pathsEqual, url } from "@utils/url";

interface Props {
    title?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
    postSlug?: string;
    headings?: MarkdownHeading[];
}

const {
    title,
    description,
    lang,
    setOGTypeArticle,
    postSlug,
    headings = [],
} = Astro.props;
const hasLeftSidebar = widgetManager.hasContentOnSide("left", headings, Astro.url.pathname);
const hasRightSidebar = widgetManager.hasContentOnSide("right", headings, Astro.url.pathname);
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const hasAnyComponents = !isHomePage && (hasLeftSidebar || hasRightSidebar);
const layoutMode = isHomePage ? "home" : hasAnyComponents ? "with-rail" : "reading";
const containerClass = isHomePage ? "editorial-content-column is-home-layout" : "editorial-content-column is-reading-layout";

/*
 * The rail is a persistent node, present in every page's markup.
 *
 * Swup replaces the *contents* of #swup-container and then moves any
 * `[data-swup-persist]` element from the outgoing DOM back into place. A rail
 * that only existed on some pages could therefore never appear on a page whose
 * HTML did not ship it — the concrete bug being: land on /, click through to
 * /archive/, and the sidebar is missing until a reload.
 *
 * Rendering it unconditionally fixes that by construction: the node always
 * exists, so it is never created, destroyed, or animated. It lives *outside*
 * #swup-container so it is not part of the page transition, and CSS alone
 * decides whether it is visible (`data-layout` = with-rail) and where it sits.
 */
const showRail = layoutMode === "with-rail";
---

<BaseLayout
    title={title}
    description={description}
    lang={lang}
    setOGTypeArticle={setOGTypeArticle}
    postSlug={postSlug}
>
    <slot slot="head" name="head" />
    {/*
     * One grid, one element.
     *
     * #main-grid is the only container that decides columns (see
     * site-layout.css). The old .editorial-page-grid wrapper is gone: it
     * existed only to be a second grid, and nothing else referenced it.
     */}
    <main id="swup-container" class:list={[containerClass, "transition-swup-fade"]} data-layout={layoutMode} data-page={postSlug ? "post" : undefined}>
        <div id="content-wrapper" class="onload-animation-up transition-leaving">
            <slot />
        </div>
    </main>
    <aside
        id="editorial-sidebar-rail"
        class="editorial-sidebar-rail"
        aria-label="站点信息"
        aria-hidden={showRail ? undefined : "true"}
        tabindex={postSlug && showRail ? 0 : undefined}
        data-layout={layoutMode}
        data-swup-persist="sidebar-rail"
    >
        <Sidebar
            id="left-sidebar"
            side="middle"
            class="editorial-sidebar"
            headings={headings}
        />
    </aside>
</BaseLayout>
