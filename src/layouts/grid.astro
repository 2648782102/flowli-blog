---
import type { MarkdownHeading } from "astro";

import { widgetManager } from "@utils/widget";
import Navbar from "@components/navbar.astro";
import Sidebar from "@components/sidebar.astro";
import Footer from "@components/footer.astro";
import BaseLayout from "./base.astro";
import { pathsEqual, url } from "@utils/url";

interface Props {
    title?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
    postSlug?: string;
    headings?: MarkdownHeading[];
}

const {
    title,
    description,
    lang,
    setOGTypeArticle,
    postSlug,
    headings = [],
} = Astro.props;
const hasLeftSidebar = widgetManager.hasContentOnSide("left", headings, Astro.url.pathname);
const hasRightSidebar = widgetManager.hasContentOnSide("right", headings, Astro.url.pathname);
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const hasAnyComponents = !isHomePage && (hasLeftSidebar || hasRightSidebar);
---

<BaseLayout
    title={title}
    description={description}
    lang={lang}
    setOGTypeArticle={setOGTypeArticle}
    postSlug={postSlug}
>
    <!-- Navbar -->
    <slot slot="head" name="head" />
    <div
        id="top-row"
        class="z-50 pointer-events-none relative max-w-(--page-width) px-0 md:px-4 mx-auto h-(--top-row-height)"
    >
        <div
            id="navbar-wrapper"
            class="pointer-events-auto sticky top-0 transition-all"
        >
            <Navbar />
        </div>
    </div>

    <!-- Main content -->
    <div id="main-content" class="relative w-full z-30 pointer-events-none min-h-[calc(100vh-var(--main-content-top))]">
        <div class="editorial-shell relative mx-auto pointer-events-auto">
            <div
                id="main-grid"
                class="editorial-main-grid"
            >
                <main id="swup-container" class="editorial-content-column transition-swup-fade">
                    <div id="grid-class-carrier" data-grid-class="" class="hidden"></div>
                    <div id="content-wrapper" class="onload-animation-up transition-leaving">
                        <slot />
                    </div>
                </main>

                {hasAnyComponents && (
                    <aside id="editorial-sidebar-rail" class="editorial-sidebar-rail" aria-label="站点信息">
                        <Sidebar
                            id="left-sidebar"
                            side="middle"
                            class="editorial-sidebar onload-animation-up"
                            headings={headings}
                        />
                    </aside>
                )}

                <div class="editorial-footer">
                    <Footer />
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
