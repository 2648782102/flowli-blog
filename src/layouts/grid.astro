---
import type { MarkdownHeading } from "astro";

import { siteConfig } from "@/config";
import { pathsEqual, url } from "@utils/url";
import { widgetManager } from "@utils/widget";
import Navbar from "@components/navbar.astro";
import FullscreenWallpaper from "@components/fullscreenWallpaper.astro";
import Banner from "@components/banner.astro";
import Sidebar from "@components/sidebar.astro";
import Footer from "@components/footer.astro";
import TocButton from "@components/tocButton.astro";
import BackToTopButton from "@components/back2TopButton.astro";
import BaseLayout from "./base.astro";
import "@styles/grid.css";

/**
 * LETTERPRESS layout.
 *
 * 视觉层完全重写：普通文档流 + 真正 sticky 的报头导航 + 居中的期刊版心，
 * 不再使用绝对定位悬浮 / banner 视差 / 玻璃卡片网格。
 * 功能层（Swup 容器、widgetManager、wallpaper、reveal）所需的所有 DOM id
 * 与 class hook 一律保留，避免任何页面失效。
 */

interface Props {
    title?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
    postSlug?: string;
    headings?: MarkdownHeading[];
}

const {
    title,
    description,
    lang,
    setOGTypeArticle,
    postSlug,
    headings = [],
} = Astro.props;

const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const shouldEnableTransparency =
    siteConfig.wallpaper.mode === "banner" ||
    siteConfig.wallpaper.mode === "fullscreen";

const {
    hasLeftSidebar,
    hasRightSidebar,
    hasAnyComponents,
    gridCols,
    leftSidebarClass,
    rightSidebarClass,
    mainContentClass,
    middleSidebarClass,
    mobileFooterClass,
} = widgetManager.getGridLayout(headings, Astro.url.pathname);
---

<BaseLayout
    title={title}
    description={description}
    lang={lang}
    setOGTypeArticle={setOGTypeArticle}
    postSlug={postSlug}
>
    <slot slot="head" name="head" />

    <!-- 报头导航：sticky 于整页顶部 -->
    <div id="top-row" class="ed-topbar sticky top-0 z-50 w-full">
        <div id="navbar-wrapper" class="w-full">
            <Navbar />
        </div>
    </div>

    <!-- 功能层保留：wallpaper.ts / reveal 依赖这些 DOM，视觉上由 editorial.css 隐藏 -->
    <FullscreenWallpaper config={siteConfig.wallpaper} class="hidden" />
    <Banner config={siteConfig.wallpaper} isHomePage={isHomePage} class="hidden" />
    {
        shouldEnableTransparency && (
            <script>
                document.body.classList.add('wallpaper-transparent');
            </script>
        )
    }

    <!-- 主内容：普通文档流 -->
    <div id="main-content" class="ed-main relative z-30 w-full">
        <div class="ed-container max-w-(--page-width) mx-auto px-4 md:px-8">
            <div
                id="main-grid"
                class:list={[
                    "ed-grid w-full grid mx-auto gap-0 md:gap-4",
                    gridCols,
                    { "mobile-no-sidebar": !hasAnyComponents },
                    { "mobile-both-sidebar": hasLeftSidebar || hasRightSidebar },
                ]}
            >
                <!-- 侧边栏列：平板合并、桌面分列，逻辑沿用 widgetManager -->
                <div class="contents lg:contents md:flex md:flex-col md:col-start-1 md:row-start-1 md:gap-4">
                    {
                        hasLeftSidebar ? (
                            <Sidebar
                                id="left-sidebar"
                                side="left"
                                class={`${leftSidebarClass} onload-animation-up`}
                                headings={headings}
                            />
                        ) : (
                            <div id="left-sidebar" class="hidden"></div>
                        )
                    }
                    {
                        hasRightSidebar ? (
                            <Sidebar
                                id="right-sidebar"
                                side="right"
                                class={`${rightSidebarClass} onload-animation-up`}
                                headings={headings}
                            />
                        ) : (
                            <div id="right-sidebar" class="hidden"></div>
                        )
                    }
                </div>

                <main id="swup-container" class:list={[mainContentClass, "transition-swup-fade"]}>
                    <div id="grid-class-carrier" data-grid-class={gridCols} class="hidden"></div>
                    <div id="content-wrapper" class="onload-animation-up transition-leaving">
                        <slot />
                        <div class="footer col-span-2 onload-animation-up hidden lg:block transition-swup-fade">
                            <Footer />
                        </div>
                    </div>
                </main>

                <div class={middleSidebarClass}>
                    <Sidebar
                        id="middle-sidebar"
                        side="middle"
                        class="onload-animation-up"
                        headings={headings}
                    />
                </div>

                <div class={mobileFooterClass}>
                    <Footer />
                </div>
            </div>
        </div>
    </div>

    <TocButton />
    <BackToTopButton />
</BaseLayout>
