---
import type { MarkdownHeading } from "astro";

import { widgetManager } from "@utils/widget";
import Sidebar from "@components/sidebar.astro";
import BaseLayout from "./base.astro";
import { pathsEqual, url } from "@utils/url";

interface Props {
    title?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
    postSlug?: string;
    headings?: MarkdownHeading[];
}

const {
    title,
    description,
    lang,
    setOGTypeArticle,
    postSlug,
    headings = [],
} = Astro.props;
const hasLeftSidebar = widgetManager.hasContentOnSide("left", headings, Astro.url.pathname);
const hasRightSidebar = widgetManager.hasContentOnSide("right", headings, Astro.url.pathname);
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const hasAnyComponents = !isHomePage && (hasLeftSidebar || hasRightSidebar);
const layoutMode = isHomePage ? "home" : hasAnyComponents ? "with-rail" : "reading";
const containerClass = isHomePage ? "editorial-content-column is-home-layout" : "editorial-content-column is-reading-layout";
---

<BaseLayout
    title={title}
    description={description}
    lang={lang}
    setOGTypeArticle={setOGTypeArticle}
    postSlug={postSlug}
>
    <slot slot="head" name="head" />
    <main id="swup-container" class:list={[containerClass, "transition-swup-fade"]} data-layout={layoutMode}>
        <div class="editorial-page-grid" data-layout={layoutMode}>
            <div id="content-wrapper" class="onload-animation-up transition-leaving">
                <slot />
            </div>
            {hasAnyComponents && (
                <aside id="editorial-sidebar-rail" class="editorial-sidebar-rail" aria-label="站点信息">
                    <Sidebar
                        id="left-sidebar"
                        side="middle"
                        class="editorial-sidebar onload-animation-up"
                        headings={headings}
                    />
                </aside>
            )}
        </div>
    </main>
</BaseLayout>
