---
import type { MarkdownHeading } from "astro";

import Footer from "@components/footer.astro";
import BaseLayout from "./base.astro";

interface Props {
    title?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
    postSlug?: string;
    headings?: MarkdownHeading[];
}

const {
    title,
    description,
    lang,
    setOGTypeArticle,
    postSlug,
} = Astro.props;
---

<BaseLayout
    title={title}
    description={description}
    lang={lang}
    setOGTypeArticle={setOGTypeArticle}
    postSlug={postSlug}
    class:list={[]}
>
    <slot slot="head" name="head" />

    <!-- Main content -->
    <div id="main-content" class="relative w-full z-30 pointer-events-none min-h-[calc(100vh-var(--main-content-top))]">
        <div class="editorial-shell relative mx-auto pointer-events-auto">
            <div
                id="main-grid"
                class="editorial-main-grid"
            >
                <main id="swup-container" class="editorial-content-column transition-swup-fade">
                    <div id="grid-class-carrier" data-grid-class="" class="hidden"></div>
                    <div id="content-wrapper" class="onload-animation-up transition-leaving">
                        <slot />
                    </div>
                </main>

                <aside id="editorial-sidebar-rail" class="editorial-sidebar-rail" aria-hidden="true"></aside>

                <div class="editorial-footer">
                    <Footer />
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
