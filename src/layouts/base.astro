---
import "katex/dist/katex.css";

import { siteConfig, profileConfig } from "@/config";
import { getAnalyticsConfig } from "@utils/analytics";
import type { Favicon } from "@/types/config";
import { defaultFavicons } from "@constants/icon";
import { LIGHT_MODE, DARK_MODE, SYSTEM_MODE } from "@constants/style";
import {
    BANNER_HEIGHT,
    BANNER_HEIGHT_EXTEND,
    BANNER_HEIGHT_HOME,
    PAGE_WIDTH,
    NAVBAR_HEIGHT,
    NAVBAR_GAP,
    NAVBAR_FOLLOW_DISTANCE,
    MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
    SIDEBAR_SPACING,
} from "@constants/layout";
import {
    MAIN_PANEL_TOP_DEFAULT,
    MAIN_PANEL_TOP_BANNER,
    MAIN_PANEL_TOP_BANNER_HOME,
} from "@constants/panelTop";
import {
    TRANSITION_DURATION_TINY,
    TRANSITION_DURATION_FASTEST,
    TRANSITION_DURATION_FAST,
    TRANSITION_DURATION_NORMAL,
    TRANSITION_DURATION_MEDIUM,
    TRANSITION_DURATION_SLOW,
    TRANSITION_DURATION_SLOWER,
    TRANSITION_DURATION_LONG,
    TRANSITION_DURATION_VERY_SLOW,
    EASE_DEFAULT,
    EASE_PAGE_IN,
    EASE_PAGE_OUT,
} from "@constants/transitions";
import { url } from "@utils/url";
import FontLoader from "@components/fontLoader.astro";
import ConfigCarrier from "@components/configCarrier.astro";
import CreationField from "@components/creationField.astro";
import Navbar from "@components/navbar.astro";
import Footer from "@components/footer.astro";
import "@styles/fancybox.css";
import "@styles/editorial-paper.css";
import "../styles/theme.css";


interface Props {
    title?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
    postSlug?: string;
}

let { title, description, lang, setOGTypeArticle, postSlug } = Astro.props;

// defines global css variables
// why doing this in BaseLayout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;

let pageTitle: string;
if (title) {
    pageTitle = `${title} - ${siteConfig.title}`;
} else {
    pageTitle = siteConfig.subtitle
        ? `${siteConfig.title} - ${siteConfig.subtitle}`
        : siteConfig.title;
}

let ogImageUrl: string | undefined;
if (siteConfig.generateOgImages && postSlug) {
    ogImageUrl = new URL(`/og/${postSlug}.png`, Astro.site).toString();
}

const favicons: Favicon[] =
    siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
    lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const { enabled: analyticsEnabled, code: analyticsCode } = getAnalyticsConfig();
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-(--page-bg) text-[14px] md:text-[16px]"
>
    <head>
        <meta charset="UTF-8" />
        <!-- Resource Preconnect -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="preconnect" href="https://code.iconify.design">
        <!-- Font Loader -->
        <FontLoader />
        <!-- title -->
        <title>{pageTitle}</title>
        <!-- description -->
        <meta name="description" content={description || pageTitle}>
        <!-- keywords -->
        {siteConfig.keywords && siteConfig.keywords.length > 0 && (
            <meta name="keywords" content={siteConfig.keywords.join(', ')} />
        )}
        <!-- author -->
        <meta name="author" content={profileConfig.name}>
        <!-- Open Graph -->
        <meta property="og:site_name" content={siteConfig.title}>
        <meta property="og:url" content={Astro.url}>
        <meta property="og:title" content={pageTitle}>
        <meta property="og:description" content={description || pageTitle}>
        {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
        {
            setOGTypeArticle ? (
                <meta property="og:type" content="article" />
            ) : (
                <meta property="og:type" content="website" />
            )
        }
        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image">
        <meta property="twitter:url" content={Astro.url}>
        <meta name="twitter:title" content={pageTitle}>
        <meta name="twitter:description" content={description || pageTitle}>
        <!-- viewport -->
        <meta name="viewport" content="width=device-width" />
        <!-- generator -->
        <meta name="generator" content={Astro.generator} />
        <!-- favicons -->
        {favicons.map(favicon => (
            <link rel="icon"
                  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
                  type={favicon.type}
                  sizes={favicon.sizes}
                  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
            />
        ))}
        <link rel="apple-touch-icon" href={url("/favicon/apple-touch-icon-light.png")} sizes="180x180" media="(prefers-color-scheme: light)" />
        <link rel="apple-touch-icon" href={url("/favicon/apple-touch-icon-dark.png")} sizes="180x180" media="(prefers-color-scheme: dark)" />
        <link rel="manifest" href={url("/favicon/site.webmanifest")} />
        <meta name="theme-color" content="#173A6D" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#07152B" media="(prefers-color-scheme: dark)" />
        <!-- Set the theme before the page is rendered to avoid a flash -->
        <script is:inline define:vars={{LIGHT_MODE, DARK_MODE, SYSTEM_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, NAVBAR_HEIGHT, configHue, defaultTheme: siteConfig.defaultTheme}}>
            // Load the theme from local storage
            const theme = localStorage.getItem('theme') || defaultTheme;
            // Apply the theme to the document
            let isDark = false;
            switch (theme) {
                case LIGHT_MODE:
                    document.documentElement.classList.remove('dark');
                    isDark = false;
                    break
                case DARK_MODE:
                    document.documentElement.classList.add('dark');
                    isDark = true;
                    break
                case SYSTEM_MODE:
                    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                        document.documentElement.classList.add('dark');
                        isDark = true;
                    } else {
                        document.documentElement.classList.remove('dark');
                        isDark = false;
                    }
            }
            const expressiveTheme = isDark ? "github-dark" : "github-light";
            document.documentElement.setAttribute("data-theme", expressiveTheme);
            // Load the hue from local storage
            const hue = localStorage.getItem('hue-v2') || configHue;
            // Apply the hue to the document
            document.documentElement.style.setProperty('--hue', hue);
            // calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
            let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
            offset = offset - offset % 4;
            document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
        </script>
        <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->
        <style define:vars={{
            configHue,
            'page-width': `${PAGE_WIDTH}rem`,
        }}></style>
        <!-- custom head -->
        <slot name="head"></slot>
        <!-- rss feed -->
        <link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>
    </head>

    <body class="min-h-screen"
    >
        <!-- 全局配置载体 -->
        <ConfigCarrier />
        <CreationField />
        <div id="top-row" class="relative z-50 mx-auto h-(--top-row-height) max-w-none px-0 md:px-4">
            <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
                <Navbar />
            </div>
        </div>
        <div id="main-content" class="relative z-30 w-full min-h-[calc(100vh-var(--main-content-top))]">
            <div class="editorial-shell relative mx-auto">
                <div id="main-grid" class="editorial-main-grid">
                    <slot />
                </div>
                <div class="editorial-footer">
                    <Footer />
                </div>
            </div>
        </div>
        <!-- Analytics -->
        {analyticsEnabled && analyticsCode && <Fragment set:html={analyticsCode} />}
    </body>
</html>


<style is:global define:vars={{
    'navbar-height': `${NAVBAR_HEIGHT / 16}rem`,
    'navbar-gap': `${NAVBAR_GAP}rem`,
    'navbar-follow-distance': `${NAVBAR_FOLLOW_DISTANCE}rem`,
    'sidebar-spacing': `${SIDEBAR_SPACING}rem`,
    'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
    'banner-height': `${BANNER_HEIGHT}vh`,
    'main-panel-overlaps-banner-height': `${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem`,
    'main-panel-top-default': MAIN_PANEL_TOP_DEFAULT,
    'main-panel-top-banner': MAIN_PANEL_TOP_BANNER,
    'main-panel-top-banner-home': MAIN_PANEL_TOP_BANNER_HOME,
    'transition-duration-tiny': `${TRANSITION_DURATION_TINY}ms`,
    'transition-duration-fastest': `${TRANSITION_DURATION_FASTEST}ms`,
    'transition-duration-fast': `${TRANSITION_DURATION_FAST}ms`,
    'transition-duration-normal': `${TRANSITION_DURATION_NORMAL}ms`,
    'transition-duration-medium': `${TRANSITION_DURATION_MEDIUM}ms`,
    'transition-duration-slow': `${TRANSITION_DURATION_SLOW}ms`,
    'transition-duration-slower': `${TRANSITION_DURATION_SLOWER}ms`,
    'transition-duration-long': `${TRANSITION_DURATION_LONG}ms`,
    'transition-duration-very-slow': `${TRANSITION_DURATION_VERY_SLOW}ms`,
    'transition-ease-default': EASE_DEFAULT,
    'transition-ease-page-in': EASE_PAGE_IN,
    'transition-ease-page-out': EASE_PAGE_OUT,
}}>
@reference "../styles/main.css";
@layer components {
    /* Base CSS variables for main content top and top-row height */
    :root {
        --main-content-top: var(--main-panel-top-default);
        --top-row-height: calc(var(--main-content-top) - var(--navbar-gap));
        --sidebar-top: var(--sidebar-top);
        --sidebar-spacing: var(--sidebar-spacing);
    }
    /* All page modes share the same content origin; see editorial-paper.css. */
}
</style>


<script>
import { pathsEqual } from "@utils/url";
import { initTheme } from "@utils/theme";
import { initHue } from "@utils/hue";
import { initMarkdownActions } from "@/utils/markdown";
import { initFancybox, cleanupFancybox } from "@utils/fancybox";
import { loadAndInitTranslate } from "@utils/language";
import { setupParticleEffects } from "@/utils/particle";


const syncNavbarCurrentPage = (pathname: string) => {
    const links = document.querySelectorAll<HTMLAnchorElement>(
        '#navbar .nav-link-item, #nav-menu-panel .mobile-menu-item > a',
    );
    const normalizedPath = pathname.replace(/\/+$/, "") || "/";

    links.forEach((link) => {
        const href = link.getAttribute('href');
        const currentUrl = href ? new URL(href, window.location.href) : null;
        const isInternal = currentUrl?.origin === window.location.origin;
        const normalizedHref = currentUrl?.pathname.replace(/\/+$/, "") || "/";
        const isCurrentPage = isInternal && pathsEqual(normalizedPath, normalizedHref);

        if (isCurrentPage) {
            link.setAttribute('aria-current', 'page');
        } else {
            link.removeAttribute('aria-current');
        }
    });
};

// 初始化Swup
const setup = () => {
    let pausedElementIds = new Set();
    window.swup.hooks.on('content:replace', () => {
        document.body.classList.toggle('is-home', document.querySelector('#swup-container')?.getAttribute('data-layout') === 'home');
        // Restore pause-swup-transition class to newly replaced persistent elements
        pausedElementIds.forEach(id => {
            const el = document.getElementById(id as string);
            if (el && el.hasAttribute('data-swup-persist')) {
                el.classList.add('pause-swup-transition');
            }
        });
    })
    window.swup.hooks.on('visit:start', (visit: {to: {url: string}}) => {
        // Disable scroll protection when a link is clicked to prevent interference with page jump scrolling to top
        if ((window as any).scrollProtectionManager && typeof (window as any).scrollProtectionManager.disable === 'function') {
            (window as any).scrollProtectionManager.disable();
        }
        syncNavbarCurrentPage(new URL(visit.to.url, window.location.origin).pathname);
        window.scrollTo({ top: 0, behavior: 'instant' });
        pausedElementIds.clear();
    });
    window.swup.hooks.on('page:view', () => {
        document.body.classList.toggle('is-home', document.querySelector('#swup-container')?.getAttribute('data-layout') === 'home');
        syncNavbarCurrentPage(window.location.pathname);
        window.scrollTo({ top: 0, behavior: 'instant' });
        // Check if the current page is a post page, if so, trigger a custom event to initialize the comment system
        setTimeout(() => {
            if (document.querySelector('[data-comment-root]')) {
                const pageLoadedEvent = new CustomEvent('twilight:page:loaded', {
                    detail: {
                        path: window.location.pathname,
                        timestamp: Date.now()
                    }
                });
                document.dispatchEvent(pageLoadedEvent);
            }
        }, 300);
        // Initialize Fancybox
        initFancybox();
    });
    initFancybox();
    window.swup.hooks.on("content:replace", () => {
            cleanupFancybox();
        },
        { before: true },
    )
}
if (window?.swup?.hooks) {
    setup()
} else {
    document.addEventListener('swup:enable', setup)
}
syncNavbarCurrentPage(window.location.pathname);
document.body.classList.toggle('is-home', document.querySelector('#swup-container')?.getAttribute('data-layout') === 'home');
document.addEventListener('twilight:sync-navbar-current', () => {
    syncNavbarCurrentPage(window.location.pathname);
});

// Initialize theme
initTheme();

// Initialize hue
initHue();

// 初始化 Markdown 相关操作以防止因 Swup 无刷新跳转的机制限制而导致操作失效
initMarkdownActions();

// Initialize translate.js
loadAndInitTranslate();

// Initialize particle effects
setupParticleEffects();

</script>
