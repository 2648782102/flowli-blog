---
export const prerender = true;


import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import {
    getTimelineStats,
    getTimelineByType,
    getCurrentItems,
    getTotalWorkExperience,
} from "@utils/timeline";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import TimelineItem from "@components/data/timelineItem.astro";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";


const title = LinkPresets[LinkPreset.Timeline].name;
const subtitle = LinkPresets[LinkPreset.Timeline].description;

// 获取时间线统计信息
const stats = getTimelineStats();
const currentItems = getCurrentItems();
const workExperience = getTotalWorkExperience();

// 获取所有时间线项目（按时间倒序）
const allTimelineItems = getTimelineByType();

---

<GridLayout title={title} description={subtitle}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <BackwardButton currentPath={Astro.url.pathname} />
            <!-- 页面标题 -->
            <div class="flex flex-col items-start justify-center mb-8">
                <h1 class="tools-eyebrow text-4xl font-bold mb-2">
                    {i18n(I18nKey.timeline)}
                </h1>
                <p class="tools-subtitle text-lg mb-8">
                    {i18n(I18nKey.timelineSubtitle)}
                </p>
            </div>
            <!-- 统计信息 -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
                <div class="tool-stat">
                    <div class="tool-stat-value">{stats.total}</div>
                    <div class="tool-stat-label">{i18n(I18nKey.timelineTotal)}</div>
                </div>
                <div class="tool-stat">
                    <div class="tool-stat-value">{stats.byType.education}</div>
                    <div class="tool-stat-label">{i18n(I18nKey.timelineEducation)}</div>
                </div>
                <div class="tool-stat">
                    <div class="tool-stat-value">{stats.byType.project}</div>
                    <div class="tool-stat-label">{i18n(I18nKey.timelineProjects)}</div>
                </div>
                <div class="tool-stat">
                    <div class="tool-stat-value">
                        {stats.byType.achievement}
                    </div>
                    <div class="tool-stat-label">{i18n(I18nKey.timelineAchievements)}</div>
                </div>
            </div>
            <!-- 当前进行中的项目 -->
            {currentItems.length > 0 && (
                <div class="mb-8">
                    <h2 class="tool-section-title mb-4">
                        {i18n(I18nKey.timelineCurrent)}
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {currentItems.map((item) => (
                            <TimelineItem item={item} layout="card" size="medium" />
                        ))}
                    </div>
                </div>
            )}
            <!-- 时间线 -->
            <div class="mb-8">
                <h2 class="tool-section-title mb-6">
                    {i18n(I18nKey.timelineHistory)}
                </h2>
                <div class="relative">
                    <!-- 时间线主轴 -->
                    <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-(--track-face)"></div>
                    <div class="space-y-8">
                        {allTimelineItems.map((item) => (
                            <TimelineItem item={item} layout="timeline" showTimeline={true} size="medium" />
                        ))}
                    </div>
                </div>
            </div>
            <!-- 类型统计 -->
            <div class="tool-divider mt-12 pt-8">
                <h2 class="tool-section-title mb-6">
                    {i18n(I18nKey.timelineStatistics)}
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- 按类型分布 -->
                    <div>
                        <h3 class="tool-section-title mb-4">
                            {i18n(I18nKey.timelineByType)}
                        </h3>
                        <div class="space-y-3">
                            {Object.entries(stats.byType).map(([type, count]) => {
                                const percentage = Math.round((count / stats.total) * 100);
                                return (
                                    <div class="flex items-center gap-3">
                                        <div class="tool-stat-label w-20 text-sm">
                                            {i18n(type === 'education' ? I18nKey.timelineEducation :
                                                        type === 'work' ? I18nKey.timelineWork :
                                                        type === 'project' ? I18nKey.timelineProject :
                                                        I18nKey.timelineAchievement)}
                                        </div>
                                        <div class="tool-progress flex-1 rounded-full h-2">
                                            <div
                                                class="h-2 rounded-full transition-all duration-600"
                                                style={`width: ${percentage}%`}
                                            ></div>
                                        </div>
                                        <div class="tool-stat-label w-12 text-sm text-right">
                                            {count}
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                    <!-- 工作经验详情（仅存在工作经历时显示） -->
                    {stats.byType.work > 0 && <div>
                        <h3 class="tool-section-title mb-4">
                            {i18n(I18nKey.timelineWorkExperience)}
                        </h3>
                        <div class="space-y-3">
                            <div class="flex justify-between items-center">
                                <span class="tool-stat-label">{i18n(I18nKey.timelineTotalExperience)}</span>
                                <span class="font-semibold">
                                    {workExperience.years} {i18n(I18nKey.timelineYears)} {workExperience.months} {i18n(I18nKey.timelineMonths)}
                                </span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="tool-stat-label">{i18n(I18nKey.timelineWorkPositions)}</span>
                                <span class="font-semibold">{stats.byType.work}</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="tool-stat-label">{i18n(I18nKey.timelineCurrentRole)}</span>
                                <span class="font-semibold">
                                    {currentItems.filter(item => item.type === 'work').length > 0 ? i18n(I18nKey.timelineEmployed) : i18n(I18nKey.timelineAvailable)}
                                </span>
                            </div>
                        </div>
                    </div>}
                </div>
            </div>
        </div>
    </div>
</GridLayout>

