---
export const prerender = true;

import type { GetStaticPaths } from "astro";

import { PAGE_SIZE } from "@constants/pagination";
import { getSortedPosts } from "@utils/post";
import { getPostUrl } from "@utils/url";
import GridLayout from "@layouts/grid.astro";
import { pathsEqual, url } from "@utils/url";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async ({ paginate }) => {
    const allBlogPosts = await getSortedPosts();
    return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const allPosts = await getSortedPosts();
const featuredPost = page.data[0];
const archiveRows = page.data.slice(1);
const latestDate = allPosts[0]?.data.published
    ? new Date(allPosts[0].data.published).toLocaleDateString("zh-CN", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    })
    : undefined;
---

<GridLayout>
    {isHomePage && (
        <div class="home-composition">
            <header class="intro-block">
                <p class="intro-kicker">独立写作 / 前端工程 / 工具观察</p>
                <h1 id="home-opening-title">把好奇心写下来<span>。</span></h1>
                <p class="intro-lede">记录技术、工具与日常。这里保存那些不急着得到结论的片段：一次调试、一件工具、一个突然值得记下的日常。</p>
                <nav class="intro-links" aria-label="站点快捷入口">
                    <a href={url("/archive/")}>全部文章</a>
                    <a href={url("/projects/")}>作品</a>
                    <a href={url("/about/")}>关于</a>
                    <a href={url("/rss/")}>RSS</a>
                </nav>
            </header>

            <section id="writing-desk" aria-labelledby="home-desk-title">
                <h2 id="home-desk-title" class="home-section-title">最近写下的</h2>
                <ul class="post-list">
                    {page.data.map((entry) => (
                        <li class="post-item">
                            <a href={getPostUrl(entry)} class="post-item-title">{entry.data.title}</a>
                            <time class="post-item-date" datetime={new Date(entry.data.published!).toISOString()}>
                                {new Date(entry.data.published!).toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}
                            </time>
                            {entry.data.description && <p class="post-item-desc">{entry.data.description}</p>}
                        </li>
                    ))}
                </ul>
            </section>
        </div>
    )}

    {!isHomePage && (
        <div class="home-feed">
            <div class="home-feed-label"><strong>最新文章</strong><span>按发布时间排列</span></div>
            <div class="home-feed-list">
                {page.data.map((entry) => (
                    <a class="home-feed-row" href={getPostUrl(entry)}>
                        <time datetime={new Date(entry.data.published!).toISOString()}>
                            {new Date(entry.data.published!).toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}
                        </time>
                        <span>{entry.data.title}</span>
                        <span class="home-feed-topic">
                            {Array.isArray(entry.data.category)
                                ? entry.data.category.join(" / ")
                                : entry.data.category || entry.data.tags?.[0] || "未分类"}
                        </span>
                        <Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
                    </a>
                ))}
            </div>
        </div>
    )}
</GridLayout>
