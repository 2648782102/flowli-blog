---
export const prerender = true;


import type { GetStaticPaths } from "astro";

import { PAGE_SIZE } from "@constants/pagination";
import { getSortedPosts } from "@utils/post";
import Pagination from "@components/pagination.astro";
import PostPage from "@components/postPage.astro";
import GridLayout from "@layouts/grid.astro";
import { pathsEqual, url } from "@utils/url";
import Cover from "@components/home/cover.astro";
import FeaturedPost from "@components/home/featuredPost.astro";
import DeskIndex from "@components/home/deskIndex.astro";
export const getStaticPaths = (async ({ paginate }) => {
    const allBlogPosts = await getSortedPosts();
    return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992


const { page } = Astro.props;

const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const allPosts = await getSortedPosts();
const firstPost = page.data[0];
const remainingPosts = page.data.slice(1);
const latestDate = allPosts[0]?.data.published
    ? new Date(allPosts[0].data.published).toLocaleDateString("zh-CN", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    })
    : undefined;
---

<GridLayout>
    {isHomePage && (
        <>
            <Cover postCount={allPosts.length} latestDate={latestDate} />
            {firstPost && <FeaturedPost entry={firstPost} />}
            <DeskIndex entries={remainingPosts} />
            <Pagination class="pagination-editorial" page={page}></Pagination>
        </>
    )}
    {!isHomePage && <div class="home-feed">
        <div class="home-feed-label">
            <strong>最新文章</strong>
            <span>按发布时间排列</span>
        </div>
        <PostPage page={page}></PostPage>
        <Pagination class="pagination-editorial" page={page}></Pagination>
    </div>}
</GridLayout>
