---
export const prerender = true;

import type { GetStaticPaths } from "astro";

import { PAGE_SIZE } from "@constants/pagination";
import { getSortedPosts } from "@utils/post";
import { getPostUrl } from "@utils/url";
import GridLayout from "@layouts/grid.astro";
import { pathsEqual, url } from "@utils/url";
import { Icon } from "astro-icon/components";
import { url as assetUrl } from "@utils/url";
import HangingScroll from "@components/common/hangingScroll.astro";

export const getStaticPaths = (async ({ paginate }) => {
    const allBlogPosts = await getSortedPosts();
    return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
/*
 * Only the first page of the home feed has the wall art. `isHomePage` is true
 * for every paginated page of `/`, so the condition has to include the page
 * number or later pages would preload two images they never render.
 */
const showsWallArt = isHomePage && page.currentPage === 1;
const latestPost = page.data[0];
const remainingPosts = page.data.slice(1);

/*
 * One definition for both the preload and the <img>, because the two drifting
 * apart is exactly how a preloaded step gets thrown away and re-fetched. The
 * widths are the measured mount widths per breakpoint; see
 * components/common/hangingScroll.astro for the measurements.
 */
const HANGING_SCROLL_SIZES = [
    "(min-width: 3440px) 550px",
    "(min-width: 2560px) 440px",
    "(min-width: 2048px) 400px",
    "(min-width: 1920px) 320px",
    "(min-width: 1440px) 270px",
    "(min-width: 1240px) 260px",
    "0px",
].join(", ");

const hangingScroll = (name: string, fallbackWidth: number) => ({
    src: `/assets/art/scroll-${name}-${fallbackWidth}.webp`,
    srcset: [350, 480, 640, 880, 900]
        .map((width) => `${assetUrl(`/assets/art/scroll-${name}-${width}.webp`)} ${width}w`)
        .join(", "),
    sizes: HANGING_SCROLL_SIZES,
});

const HANGING_SCROLL = {
    wanghui: hangingScroll("wanghui", 640),
    morikage: hangingScroll("morikage", 640),
};
const formatDate = (value: Date | string) =>
    new Date(value).toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<GridLayout>
    {showsWallArt && (
        <Fragment slot="head">
            {/*
             * Both wall scrolls are above the fold at ≥1240px, and they are by
             * far the heaviest things on the page (270KB and 190KB of image).
             *
             * The left one is the LCP element. The right one is worse than that
             * suggests: it sits near the end of the document, so the parser
             * only discovers it after the whole feed list. Measured on a
             * throttled profile, the left mount started at 97ms and the right
             * one at 1191ms — a second of blank wall on the right while the
             * left was already painted. Preloading both from the head removes
             * that asymmetry, which is far more noticeable than any individual
             * image being a few ms late.
             *
             * `imagesizes` and `imagesrcset` are taken from the same
             * HANGING_SCROLL constant the <img> below uses, so the preload
             * picks the exact candidate the layout will. When they drift the
             * browser fetches one step for the preload and another for the
             * image itself — the duplicate download this comment used to
             * describe.
             */}
            <link
                rel="preload"
                as="image"
                href={assetUrl(HANGING_SCROLL.wanghui.src)}
                imagesrcset={HANGING_SCROLL.wanghui.srcset}
                imagesizes={HANGING_SCROLL.wanghui.sizes}
                fetchpriority="high"
            />
            <link
                rel="preload"
                as="image"
                href={assetUrl(HANGING_SCROLL.morikage.src)}
                imagesrcset={HANGING_SCROLL.morikage.srcset}
                imagesizes={HANGING_SCROLL.morikage.sizes}
            />
        </Fragment>
    )}
    {isHomePage && (
        <div class="home-composition">
            <div class="wall-art wall-art--left">
                <HangingScroll
                    src={assetUrl(HANGING_SCROLL.wanghui.src)}
                    srcset={HANGING_SCROLL.wanghui.srcset}
                    sizes={HANGING_SCROLL.wanghui.sizes}
                    alt="王翚《山水》立轴，层叠山峦与林间村舍"
                    credit="Wang Hui, 1693 · The Met · CC0"
                    fetchpriority="high"
                />
            </div>

            <header class="intro-block">
                <p class="intro-kicker">独立写作 / 前端工程 / 工具观察</p>
                <h1 id="home-opening-title">把好奇心写下来<span>。</span></h1>
                <p class="intro-lede">记录技术、工具与日常。这里保存那些不急着得到结论的片段：一次调试、一件工具、一个突然值得记下的日常。</p>
            </header>

            {latestPost && (
                <section class="featured-plate scroll-edge" aria-labelledby="featured-title">
                    <div class="featured-plate-inner">
                        <p class="featured-eyebrow">最新 · {formatDate(latestPost.data.published!)}</p>
                        <h2 id="featured-title">
                            <a href={getPostUrl(latestPost)}>{latestPost.data.title}</a>
                        </h2>
                        {latestPost.data.description && (
                            <p class="featured-desc">{latestPost.data.description}</p>
                        )}
                        <a class="featured-cta" href={getPostUrl(latestPost)}>
                            阅读全文
                            <Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
                        </a>
                    </div>
                </section>
            )}

            <section id="writing-desk" aria-labelledby="home-desk-title">
                <h2 id="home-desk-title" class="home-section-title">最近写下的</h2>
                <ul class="post-list">
                    {remainingPosts.map((entry) => (
                        <li class="post-item">
                            <a href={getPostUrl(entry)} class="post-item-title">{entry.data.title}</a>
                            <time class="post-item-date" datetime={new Date(entry.data.published!).toISOString()}>
                                {new Date(entry.data.published!).toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}
                            </time>
                            {entry.data.description && <p class="post-item-desc">{entry.data.description}</p>}
                        </li>
                    ))}
                </ul>
            </section>

            <div class="wall-art wall-art--right">
                <HangingScroll
                    src={assetUrl(HANGING_SCROLL.morikage.src)}
                    srcset={HANGING_SCROLL.morikage.srcset}
                    sizes={HANGING_SCROLL.morikage.sizes}
                    alt="久隅守景《山水》立轴，孤峰与江上帆船"
                    credit="Kusumi Morikage, 17c · The Met · CC0"
                    fetchpriority="high"
                />
            </div>
        </div>
    )}

    {!isHomePage && (
        <div class="home-feed">
            <div class="home-feed-label"><strong>最新文章</strong><span>按发布时间排列</span></div>
            <div class="home-feed-list">
                {page.data.map((entry) => (
                    <a class="home-feed-row" href={getPostUrl(entry)}>
                        <time datetime={new Date(entry.data.published!).toISOString()}>
                            {new Date(entry.data.published!).toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}
                        </time>
                        <span>{entry.data.title}</span>
                        <span class="home-feed-topic">
                            {Array.isArray(entry.data.category)
                                ? entry.data.category.join(" / ")
                                : entry.data.category || entry.data.tags?.[0] || "未分类"}
                        </span>
                        <Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
                    </a>
                ))}
            </div>
        </div>
    )}
</GridLayout>
