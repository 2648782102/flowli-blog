---
export const prerender = true;

import type { GetStaticPaths } from "astro";

import { PAGE_SIZE } from "@constants/pagination";
import { getSortedPosts } from "@utils/post";
import Pagination from "@components/pagination.astro";
import PostPage from "@components/postPage.astro";
import GridLayout from "@layouts/grid.astro";
import { pathsEqual, url } from "@utils/url";

export const getStaticPaths = (async ({ paginate }) => {
    const allBlogPosts = await getSortedPosts();
    return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const len = page.data.length;
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const totalPosts = page.total ?? len;
---

<GridLayout>
    <section class="ed-feed" aria-label="文章列表">
        <header class="ed-page-head">
            <p class="ed-kicker">博客 &nbsp;/&nbsp; JOURNAL</p>
            <h1 class="ed-page-title">{isHomePage ? "最新文章" : `文章 · 第 ${page.currentPage} 页`}</h1>
            <p class="ed-page-lead">共 {totalPosts} 篇，按时间倒序排列。</p>
            <div class="ed-page-rule"></div>
        </header>

        <PostPage page={page}></PostPage>

        {page.lastPage > 1 && (
            <Pagination
                class="ed-pagination onload-animation-up"
                page={page}
                style={`animation-delay: ${len * 50}ms`}
            ></Pagination>
        )}
    </section>
</GridLayout>
