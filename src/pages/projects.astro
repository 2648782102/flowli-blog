---
export const prerender = true;


import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import {
    projectsData,
    getFeaturedProjects,
    getAllTechStack,
} from "@utils/projects";
import { UNCATEGORIZED } from "@constants/category";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import ProjectCard from "@components/data/projectCard.astro";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";


const title = LinkPresets[LinkPreset.Projects].name;
const subtitle = "从内容结构到阅读界面，记录这个站点如何一点点搭起来。";

const featuredProjects = getFeaturedProjects();
const allTechStack = getAllTechStack();
const featuredIds = new Set(featuredProjects.map((project) => project.id));

// 获取所有分类
const categories = [
    ...new Set(projectsData.map((project) => project.category)),
];

// 获取分类文本的国际化翻译
const getCategoryText = (category: string) => {
    switch (category) {
        case "web":
            return i18n(I18nKey.projectsWeb);
        case "mobile":
            return i18n(I18nKey.projectsMobile);
        case "desktop":
            return i18n(I18nKey.projectsDesktop);
        case "other":
            return i18n(I18nKey.projectsOther);
        case "website":
            return "个人网站";
        case UNCATEGORIZED:
            return i18n(I18nKey.uncategorized);
        default:
            return category;
    }
};
---

<GridLayout title={title} description={subtitle}>
    <div class="flex w-full relative min-h-32">
        <div class="project-ledger card-base z-10 relative w-full">
            <BackwardButton currentPath={Astro.url.pathname} />
            <header class="project-ledger-header">
                <p class="project-ledger-kicker">FLOWLI <span>·</span> 作品记录</p>
                <h1>
                    {i18n(I18nKey.projects)}
                </h1>
                <p class="project-ledger-intro">
                    这里记录 flowli 的个人博客，从内容结构到阅读界面的搭建过程。
                </p>
            </header>
            {featuredProjects.length > 0 && (
                <section class="project-ledger-featured" aria-label={i18n(I18nKey.projectsFeatured)}>
                    {featuredProjects.map((project) => (
                        <ProjectCard project={project} size="large" showImage={false} maxTechStack={6} />
                    ))}
                </section>
            )}
            {projectsData.some((project) => !featuredIds.has(project.id)) && (
                <div class="project-ledger-categories">
                    {categories.map((category) => {
                        const categoryProjects = projectsData.filter((project) => project.category === category && !featuredIds.has(project.id));
                        if (categoryProjects.length === 0) return null;

                        return (
                            <section class="project-category">
                                <h2>
                                    {getCategoryText(category)}
                                    <span>({categoryProjects.length})</span>
                                </h2>
                                <div class="project-category-list">
                                    {categoryProjects.map((project) => (
                                        <ProjectCard project={project} size="medium" showImage={false} maxTechStack={4} />
                                    ))}
                                </div>
                            </section>
                        );
                    })}
                </div>
            )}
            {allTechStack.length > 0 && (
                <section class="project-ledger-stack">
                    <h2>
                        {i18n(I18nKey.projectsTechStack)}
                    </h2>
                    <div class="project-stack-list">
                        {allTechStack.map((tech) => <span>{tech}</span>)}
                    </div>
                </section>
            )}
        </div>
    </div>
</GridLayout>
