---
---

<canvas id="creation-field" aria-hidden="true"></canvas>

<script>
const canvas = document.getElementById("creation-field") as HTMLCanvasElement | null;

if (canvas) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const pointCount = 220;
    const threadCount = 86;

    const randomFromSeed = (seedValue: number): number => {
        const calculated = Math.sin(seedValue * 127.1) * 43758.5453;
        return calculated - Math.floor(calculated);
    };

    const createPointData = (): Float32Array => {
        const values = new Float32Array(pointCount * 5);

        for (let index = 0; index < pointCount; index += 1) {
            const offset = index * 5;
            const seedValue = index + 1;
            values[offset] = randomFromSeed(seedValue * 1.7);
            values[offset + 1] = randomFromSeed(seedValue * 2.3);
            values[offset + 2] = randomFromSeed(seedValue * 3.1) * Math.PI * 2;
            values[offset + 3] = 8.0 + randomFromSeed(seedValue * 4.7) * 12.0;
            values[offset + 4] = randomFromSeed(seedValue * 5.9);
        }

        return values;
    };

    const createThreadData = (): Float32Array => {
        const values = new Float32Array(threadCount * 5);

        for (let index = 0; index < threadCount; index += 1) {
            const offset = index * 5;
            const progress = index / (threadCount - 1);
            values[offset] = progress;
            values[offset + 1] = 0.5 + Math.sin(progress * Math.PI * 8) * 0.06;
            values[offset + 2] = progress * Math.PI * 2;
            values[offset + 3] = 1.5;
            values[offset + 4] = progress;
        }

        return values;
    };

    const vertexShaderSource = `
        attribute vec2 aSeed;
        attribute float aPhase;
        attribute float aSize;
        attribute float aHue;
        uniform float uTime;
        uniform vec2 uResolution;
        uniform vec2 uPointer;
        uniform float uPixelRatio;
        uniform float uLineMode;
        varying float vAlpha;
        varying float vHue;

        void main() {
            float cycle = uTime * 0.16 + aPhase;
            vec2 drifting = vec2(
                sin(aSeed.x * 18.0 + cycle * 1.4) * 0.92,
                cos(aSeed.y * 15.0 - cycle * 1.1) * 0.72
            );
            float angle = aSeed.x * 6.28318 + cycle * 0.32;
            float radius = 0.16 + aSeed.y * 0.42;
            vec2 formed = vec2(cos(angle) * radius * 1.35, sin(angle) * radius * 0.82);
            float morphValue = 0.5 + 0.5 * sin(cycle * 0.55 + aSeed.x * 2.0);
            float formationStrength = 0.58 + uLineMode * 0.28;
            vec2 position = mix(drifting, formed, morphValue * formationStrength);
            vec2 pointerDelta = position - uPointer;
            float pointerDistance = max(length(pointerDelta), 0.08);
            position += (pointerDelta / pointerDistance) * (0.055 / pointerDistance) * (1.0 - uLineMode);
            position.y -= 0.04;
            gl_Position = vec4(position, 0.0, 1.0);
            float viewportScale = clamp(uResolution.y / 900.0, 0.75, 1.5);
            gl_PointSize = aSize * viewportScale * uPixelRatio * (1.0 + 0.35 * sin(cycle * 2.0));
            vAlpha = 0.58 + 0.42 * (0.5 + 0.5 * sin(cycle * 1.7 + aSeed.y * 5.0));
            vHue = aHue;
        }
    `;

    const pointFragmentShaderSource = `
        precision mediump float;
        varying float vAlpha;
        varying float vHue;

        void main() {
            vec2 pointCoordinates = gl_PointCoord - vec2(0.5);
            float distanceFromCenter = length(pointCoordinates);
            float softDisc = 1.0 - smoothstep(0.08, 0.5, distanceFromCenter);
            float brightCore = 1.0 - smoothstep(0.0, 0.18, distanceFromCenter);
            vec3 iceColor = vec3(0.62, 0.79, 1.0);
            vec3 copperColor = vec3(0.89, 0.70, 0.48);
            vec3 particleColor = mix(iceColor, copperColor, vHue);
            gl_FragColor = vec4(particleColor, (softDisc * 0.74 + brightCore * 0.58) * vAlpha);
        }
    `;

    const lineFragmentShaderSource = `
        precision mediump float;
        varying float vAlpha;
        varying float vHue;

        void main() {
            vec3 iceColor = vec3(0.62, 0.79, 1.0);
            vec3 copperColor = vec3(0.89, 0.70, 0.48);
            vec3 threadColor = mix(iceColor, copperColor, 0.35 + vHue * 0.2);
            gl_FragColor = vec4(threadColor, vAlpha * 0.14);
        }
    `;

    const compileShader = (
        context: WebGLRenderingContext,
        shaderType: number,
        source: string,
    ): WebGLShader | null => {
        const shader = context.createShader(shaderType);
        if (!shader) return null;
        context.shaderSource(shader, source);
        context.compileShader(shader);
        if (!context.getShaderParameter(shader, context.COMPILE_STATUS)) {
            context.deleteShader(shader);
            return null;
        }
        return shader;
    };

    const createProgram = (
        context: WebGLRenderingContext,
        fragmentSource: string,
    ): WebGLProgram | null => {
        const vertexShader = compileShader(context, context.VERTEX_SHADER, vertexShaderSource);
        const fragmentShader = compileShader(context, context.FRAGMENT_SHADER, fragmentSource);
        if (!vertexShader || !fragmentShader) return null;

        const program = context.createProgram();
        if (!program) return null;
        context.attachShader(program, vertexShader);
        context.attachShader(program, fragmentShader);
        context.linkProgram(program);
        context.deleteShader(vertexShader);
        context.deleteShader(fragmentShader);
        if (!context.getProgramParameter(program, context.LINK_STATUS)) {
            context.deleteProgram(program);
            return null;
        }
        return program;
    };

    const setupWebGL = (
        canvasElement: HTMLCanvasElement,
        context: WebGLRenderingContext,
    ): boolean => {
        const pointProgram = createProgram(context, pointFragmentShaderSource);
        const lineProgram = createProgram(context, lineFragmentShaderSource);
        if (!pointProgram || !lineProgram) return false;

        const pointBuffer = context.createBuffer();
        const threadBuffer = context.createBuffer();
        if (!pointBuffer || !threadBuffer) return false;

        context.bindBuffer(context.ARRAY_BUFFER, pointBuffer);
        context.bufferData(context.ARRAY_BUFFER, createPointData(), context.STATIC_DRAW);
        context.bindBuffer(context.ARRAY_BUFFER, threadBuffer);
        context.bufferData(context.ARRAY_BUFFER, createThreadData(), context.STATIC_DRAW);

        let viewportWidth = window.innerWidth;
        let viewportHeight = window.innerHeight;
        let pixelRatio = Math.min(window.devicePixelRatio || 1, 1.75);
        let pointerX = 0;
        let pointerY = 0;
        let targetPointerX = 0;
        let targetPointerY = 0;

        const resizeCanvas = (): void => {
            viewportWidth = window.innerWidth;
            viewportHeight = window.innerHeight;
            pixelRatio = Math.min(window.devicePixelRatio || 1, 1.75);
            canvasElement.width = Math.max(1, Math.floor(viewportWidth * pixelRatio));
            canvasElement.height = Math.max(1, Math.floor(viewportHeight * pixelRatio));
            context.viewport(0, 0, canvasElement.width, canvasElement.height);
        };

        const bindGeometry = (
            program: WebGLProgram,
            buffer: WebGLBuffer,
        ): void => {
            context.bindBuffer(context.ARRAY_BUFFER, buffer);
            const stride = 5 * Float32Array.BYTES_PER_ELEMENT;
            const attributes = [
                { name: "aSeed", size: 2, offset: 0 },
                { name: "aPhase", size: 1, offset: 2 },
                { name: "aSize", size: 1, offset: 3 },
                { name: "aHue", size: 1, offset: 4 },
            ];

            for (const attribute of attributes) {
                const location = context.getAttribLocation(program, attribute.name);
                if (location < 0) continue;
                context.enableVertexAttribArray(location);
                context.vertexAttribPointer(
                    location,
                    attribute.size,
                    context.FLOAT,
                    false,
                    stride,
                    attribute.offset * Float32Array.BYTES_PER_ELEMENT,
                );
            }
        };

        const applyUniforms = (
            program: WebGLProgram,
            animationTime: number,
            lineMode: number,
        ): void => {
            context.useProgram(program);
            context.uniform1f(context.getUniformLocation(program, "uTime"), animationTime);
            context.uniform2f(context.getUniformLocation(program, "uResolution"), viewportWidth, viewportHeight);
            context.uniform2f(context.getUniformLocation(program, "uPointer"), pointerX, pointerY);
            context.uniform1f(context.getUniformLocation(program, "uPixelRatio"), pixelRatio);
            context.uniform1f(context.getUniformLocation(program, "uLineMode"), lineMode);
        };

        const drawFrame = (timestamp: number): void => {
            const animationTime = reducedMotion ? 0 : timestamp / 1000;
            if (!document.body.classList.contains("is-home") || document.hidden) return;

            if (!reducedMotion) {
                pointerX += (targetPointerX - pointerX) * 0.035;
                pointerY += (targetPointerY - pointerY) * 0.035;
            }

            context.clearColor(0, 0, 0, 0);
            context.clear(context.COLOR_BUFFER_BIT);
            context.enable(context.BLEND);
            context.blendFunc(context.SRC_ALPHA, context.ONE);

            applyUniforms(lineProgram, animationTime, 1);
            bindGeometry(lineProgram, threadBuffer);
            context.drawArrays(context.LINE_STRIP, 0, threadCount);

            applyUniforms(pointProgram, animationTime, 0);
            bindGeometry(pointProgram, pointBuffer);
            context.drawArrays(context.POINTS, 0, pointCount);
        };

        const animationLoop = (timestamp: number): void => {
            drawFrame(timestamp);
            window.requestAnimationFrame(animationLoop);
        };

        window.addEventListener("resize", resizeCanvas);
        window.addEventListener("pointermove", (event) => {
            targetPointerX = (event.clientX / viewportWidth) * 2 - 1;
            targetPointerY = 1 - (event.clientY / viewportHeight) * 2;
        }, { passive: true });

        resizeCanvas();
        canvasElement.dataset.renderer = "webgl";
        window.requestAnimationFrame(animationLoop);
        return true;
    };

    const setupCanvasFallback = (
        canvasElement: HTMLCanvasElement,
        context: CanvasRenderingContext2D,
    ): void => {
        const pointData = createPointData();
        let viewportWidth = window.innerWidth;
        let viewportHeight = window.innerHeight;
        let pixelRatio = Math.min(window.devicePixelRatio || 1, 1.75);

        const resizeCanvas = (): void => {
            viewportWidth = window.innerWidth;
            viewportHeight = window.innerHeight;
            pixelRatio = Math.min(window.devicePixelRatio || 1, 1.75);
            canvasElement.width = Math.max(1, Math.floor(viewportWidth * pixelRatio));
            canvasElement.height = Math.max(1, Math.floor(viewportHeight * pixelRatio));
            context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        };

        type ProjectedParticle = { horizontal: number; vertical: number; alpha: number; hue: number };

        const projectParticle = (offset: number, animationTime: number): ProjectedParticle => {
            const seedX = pointData[offset];
            const seedY = pointData[offset + 1];
            const phase = pointData[offset + 2];
            const cycle = animationTime * 0.16 + phase;
            const driftingX = Math.sin(seedX * 18 + cycle * 1.4) * 0.92;
            const driftingY = Math.cos(seedY * 15 - cycle * 1.1) * 0.72;
            const angle = seedX * Math.PI * 2 + cycle * 0.32;
            const radius = 0.16 + seedY * 0.42;
            const formedX = Math.cos(angle) * radius * 1.35;
            const formedY = Math.sin(angle) * radius * 0.82;
            const morphValue = (0.5 + 0.5 * Math.sin(cycle * 0.55 + seedX * 2)) * 0.58;
            const normalizedX = driftingX + (formedX - driftingX) * morphValue;
            const normalizedY = driftingY + (formedY - driftingY) * morphValue - 0.04;
            return {
                horizontal: (normalizedX * 0.5 + 0.5) * viewportWidth,
                vertical: (0.5 - normalizedY * 0.5) * viewportHeight,
                alpha: 0.18 + 0.42 * (0.5 + 0.5 * Math.sin(cycle * 1.7 + seedY * 5)),
                hue: pointData[offset + 4],
            };
        };

        const drawFrame = (timestamp: number): void => {
            if (!document.body.classList.contains("is-home") || document.hidden) return;
            const animationTime = reducedMotion ? 0 : timestamp / 1000;
            const projected: ProjectedParticle[] = [];

            for (let index = 0; index < pointCount; index += 1) {
                projected.push(projectParticle(index * 5, animationTime));
            }

            context.clearRect(0, 0, viewportWidth, viewportHeight);
            context.globalCompositeOperation = "lighter";
            context.lineWidth = 1;

            for (let firstIndex = 0; firstIndex < pointCount; firstIndex += 1) {
                const firstParticle = projected[firstIndex];
                for (let secondIndex = firstIndex + 1; secondIndex < pointCount; secondIndex += 1) {
                    const secondParticle = projected[secondIndex];
                    const horizontalDistance = firstParticle.horizontal - secondParticle.horizontal;
                    const verticalDistance = firstParticle.vertical - secondParticle.vertical;
                    const distance = Math.hypot(horizontalDistance, verticalDistance);
                    if (distance > 120) continue;
                    const lineAlpha = (1 - distance / 120) * Math.min(firstParticle.alpha, secondParticle.alpha) * 0.055;
                    context.strokeStyle = `rgba(158, 201, 255, ${lineAlpha})`;
                    context.beginPath();
                    context.moveTo(firstParticle.horizontal, firstParticle.vertical);
                    context.lineTo(secondParticle.horizontal, secondParticle.vertical);
                    context.stroke();
                }
            }

            for (const particle of projected) {
                const pointRadius = 1.2 + particle.hue * 1.8;
                context.fillStyle = particle.hue > 0.78
                    ? `rgba(226, 181, 124, ${particle.alpha * 0.34})`
                    : `rgba(158, 201, 255, ${particle.alpha * 0.34})`;
                context.beginPath();
                context.arc(particle.horizontal, particle.vertical, pointRadius, 0, Math.PI * 2);
                context.fill();
            }

            context.globalCompositeOperation = "source-over";
        };

        const animationLoop = (timestamp: number): void => {
            drawFrame(timestamp);
            window.requestAnimationFrame(animationLoop);
        };

        window.addEventListener("resize", resizeCanvas);
        resizeCanvas();
        canvasElement.dataset.renderer = "canvas2d";
        window.requestAnimationFrame(animationLoop);
    };

    const webglContext = canvas.getContext("webgl", {
        alpha: true,
        antialias: true,
        premultipliedAlpha: false,
    }) as WebGLRenderingContext | null;
    const webglReady = webglContext ? setupWebGL(canvas, webglContext) : false;

    if (!webglReady) {
        const fallbackCanvas = webglContext ? canvas.cloneNode(false) as HTMLCanvasElement : canvas;
        if (webglContext) canvas.replaceWith(fallbackCanvas);
        const fallbackContext = fallbackCanvas.getContext("2d");
        if (fallbackContext) setupCanvasFallback(fallbackCanvas, fallbackContext);
    }
}
</script>
