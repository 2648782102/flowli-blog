---
interface Props {
    src: string;
    srcset?: string;
    alt: string;
    credit?: string;
    class?: string;
    /*
     * `fetchpriority` is what gives the homepage pair its head start; it is
     * honoured on a lazy image as soon as the element is in the viewport, so
     * the LCP still lands at ~100ms without an eager request on phones where
     * the mounts are hidden.
     */
    fetchpriority?: "high" | "auto" | "low";
}

const { src, srcset, alt, credit, class: className, fetchpriority = "auto" } = Astro.props;

/*
 * The slot is not a fixed fraction of the viewport: --wall-height is
 * min(column × 0.62, 62vh, gutter), so a vw-based `sizes` is wrong at both
 * ends of the desktop range. Measured mount widths, at 1×:
 *
 *   1240 → 172px   1280 → 218px   1440–1919 → 268px
 *   1920 → 317px   2560 → 436px   3840 → 549px
 *
 * The old `24vw` asked for 384px at 1600 (a 268px mount) and 19vw still
 * over-declared by 15% at 1920, so a 2× display landed on the 900px
 * original either way. Below 1240px the mounts are display:none.
 */
const SIZES = [
    "(min-width: 3440px) 550px",
    "(min-width: 2560px) 440px",
    "(min-width: 2048px) 400px",
    "(min-width: 1920px) 320px",
    "(min-width: 1440px) 270px",
    "(min-width: 1240px) 260px",
    "0px",
].join(", ");

/*
 * The mounts are the LCP element, so they carry `fetchpriority="high"`. The
 * image is `lazy` regardless: below 1240px `.wall-art` is `display:none`, and
 * an eager img still downloads its `src` fallback there — 52 KB on a phone
 * for an image that is never painted, because `media` on an img does not stop
 * the request. A lazy image inside a hidden element is never fetched, and
 * measured locally both settings paint the LCP at 88–100 ms.
 */
---

<figure class:list={["hanging-scroll", className]}>
    <div class="hanging-scroll__art">
        <img
            src={src}
            srcset={srcset}
            sizes={SIZES}
            alt={alt}
            loading="lazy"
            fetchpriority={fetchpriority}
            decoding="async"
        />
    </div>
    {credit && <figcaption class="hanging-scroll__credit">{credit}</figcaption>}
</figure>

<style>
    /*
     * A physically rendered hanging scroll, baked from a Three.js scene.
     * The silk damask and painting are a public-domain museum photograph of
     * the real mount. The sheet and its silk-wrapped 天杆 are drawn unlit —
     * the photograph already carries gallery light — so only curvature
     * shading is multiplied in. There is deliberately no 地杆. The page only
     * displays a transparent WebP; depth comes from the shadows below.
     */
    .hanging-scroll {
        position: relative;
        margin: 0;
        isolation: isolate;
    }

    .hanging-scroll__art {
        position: relative;
        display: block;
        /*
         * The silhouette is a rectangle of paper a few millimetres off the
         * wall, so its edge should stay crisp and the depth should come from
         * the shadow instead. Three layers, stacked from ambient to contact:
         * a wide soft ambient shadow, a directed one cast down and to the
         * right by the upper-left key, and a tight dark contact line right
         * under the bottom edge where the paper meets the wall.
         *
         * An earlier version faded the left, right and bottom edges to
         * transparency instead. Blending paper into a wall through alpha
         * darkens toward the backdrop, so on the dark theme the mount grew a
         * grey halo — the paper looked dirty rather than distant. Shadows do
         * the same job without touching the paper's own colour.
         */
        filter:
            drop-shadow(0 16px 24px rgb(20 14 8 / 0.34))
            drop-shadow(5px 9px 12px rgb(20 14 8 / 0.26))
            drop-shadow(1px 2px 2px rgb(20 14 8 / 0.30));
    }

    .hanging-scroll__art img {
        display: block;
        width: 100%;
        height: auto;
    }

    .hanging-scroll__credit {
        display: block;
        margin-block-start: 0.9rem;
        font-family: var(--editorial-mono);
        font-size: 0.55rem;
        letter-spacing: 0.04em;
        line-height: 1.5;
        text-align: center;
        color: var(--ink-faint);
        opacity: 0.62;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    html:root.dark .hanging-scroll__art {
        /*
         * On a near-black wall a long soft shadow is invisible; what still
         * reads is the tight contact line and a short falloff, so the mount
         * sits on the surface rather than floating in front of it.
         */
        filter:
            drop-shadow(0 14px 22px rgb(0 0 0 / 0.72))
            drop-shadow(4px 8px 10px rgb(0 0 0 / 0.60))
            drop-shadow(1px 2px 3px rgb(0 0 0 / 0.62));
    }
</style>
