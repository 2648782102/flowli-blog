---
interface Props {
    src: string;
    srcset?: string;
    alt: string;
    credit?: string;
    class?: string;
}

const { src, srcset, alt, credit, class: className } = Astro.props;
---

<figure class:list={["hanging-scroll", className]}>
    <div class="hanging-scroll__art">
        <img
            src={src}
            srcset={srcset}
            sizes="(min-width: 1240px) 24vw, 0px"
            alt={alt}
            loading="lazy"
            decoding="async"
        />
    </div>
    {credit && <figcaption class="hanging-scroll__credit">{credit}</figcaption>}
</figure>

<style>
    /*
     * A physically rendered hanging scroll, baked from a Three.js scene.
     * The silk damask and painting are a public-domain museum photograph of
     * the real mount; the rods, knobs and curvature are rendered geometry
     * lit from the upper left. The page only displays a transparent WebP.
     */
    .hanging-scroll {
        position: relative;
        margin: 0;
        isolation: isolate;
    }

    .hanging-scroll__art {
        position: relative;
        display: block;
        filter: drop-shadow(4px 11px 9px rgb(24 18 9 / 0.42))
                drop-shadow(1px 2px 2px rgb(24 18 9 / 0.30));
    }

    .hanging-scroll__art img {
        display: block;
        width: 100%;
        height: auto;
        /*
         * The mount is a hard-edged rectangle on a soft wall, so its
         * silhouette is the loudest thing in the margin. A few millimetres of
         * fade at the left, right and bottom edges is enough to take the
         * cut-out look off it — anything wider starts dissolving the silk
         * itself and reads as a blur rather than as air. Top stays crisp:
         * that is the 天杆, and softening it would look like a mistake.
         *
         * The two mask layers would otherwise combine with a union, which
         * cancels both fades; mask-composite: intersect makes them multiply.
         *
         * The baked WebP keeps a 4.5% transparent margin on every side so the
         * sheet never touches the canvas edge. The fade has to start inside
         * that margin, otherwise it dissolves empty pixels and the paper
         * itself stays hard-edged.
         */
        --scroll-fade-x: 0.4rem;
        --scroll-fade-y: 0.35rem;
        -webkit-mask-image:
            linear-gradient(to right,
                transparent 0,
                #000 var(--scroll-fade-x),
                #000 calc(100% - var(--scroll-fade-x)),
                transparent 100%),
            linear-gradient(to bottom,
                #000 calc(100% - var(--scroll-fade-y)),
                transparent 100%);
        mask-image:
            linear-gradient(to right,
                transparent 0,
                #000 var(--scroll-fade-x),
                #000 calc(100% - var(--scroll-fade-x)),
                transparent 100%),
            linear-gradient(to bottom,
                #000 calc(100% - var(--scroll-fade-y)),
                transparent 100%);
        -webkit-mask-composite: source-in;
        mask-composite: intersect;
    }

    .hanging-scroll__credit {
        display: block;
        margin-block-start: 0.9rem;
        font-family: var(--editorial-mono);
        font-size: 0.55rem;
        letter-spacing: 0.04em;
        line-height: 1.5;
        text-align: center;
        color: var(--ink-faint);
        opacity: 0.62;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    html:root.dark .hanging-scroll__art {
        filter: drop-shadow(3px 9px 9px rgb(0 0 0 / 0.66))
                drop-shadow(1px 2px 3px rgb(0 0 0 / 0.5));
    }
</style>
