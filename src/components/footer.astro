---
import { profileConfig } from "@/config";
import { url } from "@utils/url";

const currentYear = new Date().getFullYear();
---

<footer class="ed-footer">
    <div class="ed-footer-rule"></div>
    <div class="ed-footer-line">
        <span>&copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}</span>
        <nav class="ed-footer-links" aria-label="订阅与索引">
            <a href={url('rss/')}>RSS</a>
            <a href={url('atom/')}>Atom</a>
            <a href={url('sitemap-index.xml')}>Sitemap</a>
            <a href="https://github.com/2648782102" target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
        <span class="ed-footer-powered">
            Powered by
            <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> &amp;
            <a href="https://pages.github.com/" target="_blank" rel="noopener noreferrer">GitHub Pages</a>
        </span>
    </div>
</footer>
