---
import { profileConfig } from "@/config";
import { url } from "@utils/url";

const currentYear = new Date().getFullYear();
---

<footer class="ed-footer">
    <div class="ed-footer-rule"></div>
    <div class="ed-footer-grid">
        <span class="ed-footer-sig">flowli · 个人博客</span>
        <span>&copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved.</span>
        <nav aria-label="订阅与索引">
            <a href={url('rss/')} onclick={`event.preventDefault(); navigateToPage('${url('rss/')}')`}>RSS</a>
            &nbsp;/&nbsp;
            <a href={url('atom/')} onclick={`event.preventDefault(); navigateToPage('${url('atom/')}')`}>Atom</a>
            &nbsp;/&nbsp;
            <a target="_blank" href={url('sitemap-index.xml')}>Sitemap</a>
        </nav>
        <span>
            Powered by
            <a target="_blank" href="https://astro.build">Astro</a> &amp;
            <a target="_blank" href="https://pages.github.com/">GitHub Pages</a>
        </span>
    </div>
</footer>
