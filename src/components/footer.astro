---
import { profileConfig } from "@/config";
import { url } from "@utils/url";


const currentYear = new Date().getFullYear();
---

<footer class="flowli-footer">
    <div class="flowli-footer-rule" aria-hidden="true"></div>
    <div class="flowli-footer-inner">
        <span class="flowli-footer-mark" aria-hidden="true">f</span>
        <p class="flowli-footer-copy">
            &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved.
        </p>
        <nav class="flowli-footer-links" aria-label="订阅与站点索引">
            <a href={url('rss/')}>RSS</a>
            <a href={url('atom/')}>Atom</a>
            <a target="_blank" href={url('sitemap-index.xml')}>Sitemap</a>
            <span aria-hidden="true">·</span>
            <a target="_blank" href="https://astro.build">Astro</a>
            <a target="_blank" href="https://pages.github.com/">GitHub Pages</a>
        </nav>
    </div>
</footer>
