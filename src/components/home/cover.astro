---
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "@/config";

interface Props {
    postCount: number;
    latestDate?: string;
}

const { postCount, latestDate } = Astro.props;
const github = profileConfig.links.find((link) => link.name.toLowerCase() === "github");
---

<section class="flowli-masthead" aria-labelledby="flowli-masthead-title">
    <div class="flowli-masthead-copy">
        <p class="flowli-masthead-kicker">flowli · 独立写作 · 前端工程</p>
        <h1 id="flowli-masthead-title">把好奇心<br />写下来<span class="flowli-stop">。</span></h1>
        <p class="flowli-masthead-lede">{siteConfig.subtitle}。这里收着调试时的一行发现、工具用顺手的一刻，和日常里值得停一下的片段。</p>

        <div class="flowli-masthead-actions">
            <a class="flowli-action flowli-action-primary" href="#writing-desk">
                开始阅读
                <Icon name="material-symbols:south-rounded" aria-hidden="true" />
            </a>
            {github && (
                <a class="flowli-action" href={github.url} target="_blank" rel="noreferrer">
                    <Icon name={github.icon} aria-hidden="true" />
                    <span>GitHub</span>
                </a>
            )}
        </div>

        <dl class="flowli-masthead-facts">
            <div>
                <dt>已写下</dt>
                <dd>{postCount.toString().padStart(2, "0")} 篇</dd>
            </div>
            <div>
                <dt>最近更新</dt>
                <dd>{latestDate || "持续记录"}</dd>
            </div>
            <div>
                <dt>写作地点</dt>
                <dd>深圳</dd>
            </div>
        </dl>
    </div>

    <div class="flowli-lens" aria-hidden="true">
        <div class="flowli-lens-glass"></div>
        <span class="flowli-lens-letter">f</span>
        <div class="flowli-lens-caption">
            <strong>flowli</strong>
            <span>notes / tools / days</span>
            <span>{latestDate || "in progress"}</span>
        </div>
    </div>
</section>
