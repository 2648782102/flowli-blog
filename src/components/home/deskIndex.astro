---
import { Icon } from "astro-icon/components";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { getPostUrl, url } from "@utils/url";

interface Props {
    entries: CollectionEntry<"posts">[];
}

const { entries } = Astro.props;
const rows = await Promise.all(entries.map(async (entry) => {
    const { remarkPluginFrontmatter } = await render(entry);
    const topic = Array.isArray(entry.data.category)
        ? entry.data.category.join(" / ")
        : entry.data.category || entry.data.tags?.[0] || "未分类";
    return {
        entry,
        topic,
        excerpt: entry.data.description || remarkPluginFrontmatter.excerpt,
        date: new Date(entry.data.published!).toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" }),
    };
}));
---

<section class="flowli-section" id="writing-desk" aria-labelledby="flowli-desk-title">
    <div class="flowli-section-label">
        <span>02 / 写作台</span>
        <h2 id="flowli-desk-title">最近写下的</h2>
        <p>按时间留着，像桌角一叠没有整理完的纸。</p>
    </div>

    <div>
        <div class="flowli-desk-list">
            {rows.map(({ entry, topic, excerpt, date }) => (
                <a class="flowli-desk-row" href={getPostUrl(entry)}>
                    <time class="flowli-desk-date" datetime={new Date(entry.data.published!).toISOString()}>{date}</time>
                    <div>
                        <span class="flowli-desk-title">{entry.data.title}</span>
                        {excerpt && <p class="flowli-desk-excerpt">{excerpt}</p>}
                    </div>
                    <span class="flowli-desk-topic">{topic}</span>
                    <span class="flowli-desk-arrow" aria-hidden="true">
                        <Icon name="material-symbols:arrow-forward-rounded" />
                    </span>
                </a>
            ))}
        </div>
        <a class="flowli-section-link" href={url("/archive/")}>
            查看全部文章 <Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
        </a>
    </div>
</section>
