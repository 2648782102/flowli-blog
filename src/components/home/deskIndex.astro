---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import { getPostUrl, url } from "@utils/url";

interface Props {
    entries: CollectionEntry<"posts">[];
}

const { entries } = Astro.props;
const rows = await Promise.all(entries.map(async (entry, index) => {
    const { remarkPluginFrontmatter } = await render(entry);
    const topic = Array.isArray(entry.data.category)
        ? entry.data.category.join(" / ")
        : entry.data.category || entry.data.tags?.[0] || "未分类";
    return {
        entry,
        index: String(index + 1).padStart(2, "0"),
        topic,
        excerpt: entry.data.description || remarkPluginFrontmatter.excerpt,
        minutes: remarkPluginFrontmatter.minutes,
    };
}));
---

<section class="desk-index" id="writing-desk" aria-labelledby="writing-desk-title">
    <header class="desk-header">
        <div>
            <p class="desk-eyebrow">写作台</p>
            <h2 id="writing-desk-title">最近写下的</h2>
        </div>
        <a href={url("/archive/")}>查看全部 <Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" /></a>
    </header>

    <div class="desk-list">
        {rows.map(({ entry, index, topic, excerpt, minutes }) => (
            <article class="desk-row">
                <span class="desk-number">{index}</span>
                <div class="desk-copy">
                    <a href={getPostUrl(entry)} class="desk-title">{entry.data.title}</a>
                    {excerpt && <p>{excerpt}</p>}
                    <div class="desk-meta">
                        <span>{topic}</span>
                        <span>{minutes} 分钟</span>
                        <time datetime={new Date(entry.data.published!).toISOString()}>
                            {new Date(entry.data.published!).toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}
                        </time>
                    </div>
                </div>
                <a class="desk-arrow" href={getPostUrl(entry)} aria-label={`阅读 ${entry.data.title}`}>
                    <Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
                </a>
            </article>
        ))}
    </div>
</section>

<style>
    .desk-index {
        scroll-margin-top: 6rem;
        padding-top: 1rem;
    }

    .desk-header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--hairline-strong);
    }

    .desk-eyebrow {
        margin: 0 0 0.45rem;
        color: var(--accent);
        font-size: 0.78rem;
        font-weight: 650;
    }

    .desk-header h2 {
        margin: 0;
        font-size: clamp(1.8rem, 3vw, 2.6rem);
    }

    .desk-header > a {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--accent);
        font-size: 0.82rem;
        font-weight: 650;
        text-decoration: none;
        white-space: nowrap;
    }

    .desk-header > a :global(svg) {
        width: 1rem;
        height: 1rem;
    }

    .desk-list {
        display: flex;
        flex-direction: column;
    }

    .desk-row {
        display: grid;
        grid-template-columns: 3rem minmax(0, 1fr) 2.5rem;
        gap: 1rem;
        align-items: start;
        padding: 1.6rem 0;
        border-bottom: 1px solid var(--hairline);
    }

    .desk-number {
        padding-top: 0.4rem;
        color: var(--ink-faint);
        font-family: var(--editorial-mono);
        font-size: 0.75rem;
    }

    .desk-copy {
        min-width: 0;
    }

    .desk-title {
        color: var(--ink);
        font-family: var(--editorial-serif);
        font-size: clamp(1.35rem, 2.2vw, 1.7rem);
        font-weight: 600;
        line-height: 1.4;
        text-decoration: none;
    }

    .desk-title:hover {
        color: var(--accent);
    }

    .desk-copy p {
        max-width: 58ch;
        margin: 0.6rem 0 0;
        line-height: 1.75;
    }

    .desk-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem 1rem;
        margin-top: 0.9rem;
        color: var(--ink-faint);
        font-family: var(--editorial-mono);
        font-size: 0.7rem;
    }

    .desk-arrow {
        display: grid;
        width: 2.25rem;
        height: 2.25rem;
        place-items: center;
        border: 1px solid var(--hairline);
        border-radius: 50%;
        color: var(--accent);
    }

    .desk-arrow :global(svg) {
        width: 1.05rem;
        height: 1.05rem;
    }

    .desk-row:hover .desk-arrow {
        border-color: var(--accent);
        background: var(--primary-light);
    }

    @media (max-width: 520px) {
        .desk-row {
            grid-template-columns: 2rem minmax(0, 1fr);
        }

        .desk-arrow {
            display: none;
        }
    }
</style>
