---
import { Icon } from "astro-icon/components";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { getFileDirFromPath, getPostUrl } from "@utils/url";
import ImageWrapper from "@components/common/imageWrapper.astro";

interface Props {
    entry: CollectionEntry<"posts">;
}

const { entry } = Astro.props;
const postUrl = getPostUrl(entry);
const { title, published, description, cover } = entry.data;
const { remarkPluginFrontmatter } = await render(entry);
const excerpt = description || remarkPluginFrontmatter.excerpt;
const publishedDate = new Date(published!).toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
});
const imageBaseDir = getFileDirFromPath(entry.filePath || "");
---

<section class="flowli-section" aria-labelledby="flowli-featured-title">
    <div class="flowli-section-label">
        <span>01 / 最近一篇</span>
        <h2 id="flowli-featured-title">从这篇开始</h2>
        <p>不必按顺序读，挑一个顺眼的标题就好。</p>
    </div>

    <a class="flowli-feature" href={postUrl} aria-label={`阅读 ${title}`}>
        <div class="flowli-feature-copy">
            <div class="flowli-feature-meta">
                <span>最新</span>
                <time datetime={new Date(published!).toISOString()}>{publishedDate}</time>
            </div>
            <h3>{title}</h3>
            {excerpt && <p>{excerpt}</p>}
            <div class="flowli-feature-foot">
                <span>{remarkPluginFrontmatter.minutes} 分钟阅读</span>
                <span class="flowli-feature-cta">继续阅读 <Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" /></span>
            </div>
        </div>
        <div class="flowli-feature-visual">
            {cover ? (
                <ImageWrapper src={cover} basePath={imageBaseDir} alt="" loading="lazy" />
            ) : (
                <div class="flowli-feature-monogram">流</div>
            )}
        </div>
    </a>
</section>
