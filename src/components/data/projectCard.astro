---
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";


export interface Props {
    project: {
        id: string;
        title: string;
        description: string;
        image?: string;
        category: string;
        techStack: string[];
        status: "completed" | "in-progress" | "planned";
        demoUrl?: string;
        sourceUrl?: string;
        startDate?: string;
        endDate?: string;
        featured?: boolean;
        tags?: string[];
        basePath?: string;
    };
    size?: "small" | "medium" | "large";
    showImage?: boolean;
    maxTechStack?: number;
}

const { project, maxTechStack = 4 } = Astro.props;

const statusLabels = {
    completed: i18n(I18nKey.projectsCompleted),
    "in-progress": i18n(I18nKey.projectsInProgress),
    planned: i18n(I18nKey.projectsPlanned),
};

const categoryLabels: Record<string, string> = {
    website: "个人网站",
};

const formattedDate = (date?: string) => {
    if (!date) return "";
    const parsed = new Date(`${date}T00:00:00`);
    return Number.isNaN(parsed.getTime())
        ? date
        : new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "short" }).format(parsed);
};

const period = project.endDate
    ? `${formattedDate(project.startDate)} — ${formattedDate(project.endDate)}`
    : formattedDate(project.startDate);
---

<article class:list={["project-card", { "project-card-featured": project.featured }]}>
    <div class="project-card-content">
        <div class="project-card-meta">
            <span>{categoryLabels[project.category] ?? project.category}</span>
            {period && <span>{period}</span>}
            <span class="project-card-status">{statusLabels[project.status]}</span>
        </div>
        <h2>{project.title}</h2>
        <p class="project-card-description">{project.description}</p>
        {project.techStack.length > 0 && (
            <ul class="project-card-tech" aria-label={i18n(I18nKey.projectsTechStack)}>
                {project.techStack.slice(0, maxTechStack).map((tech) => <li>{tech}</li>)}
                {project.techStack.length > maxTechStack && <li>+{project.techStack.length - maxTechStack}</li>}
            </ul>
        )}
        {project.tags && project.tags.length > 0 && (
            <ul class="project-card-tags" aria-label="项目标签">
                {project.tags.map((tag) => <li>#{tag}</li>)}
            </ul>
        )}
        <div class="project-card-links">
            {project.demoUrl && (
                <a href={project.demoUrl} target="_blank" rel="noopener noreferrer">
                    {i18n(I18nKey.projectsDemo)} <span aria-hidden="true">↗</span>
                </a>
            )}
            {project.sourceUrl && (
                <a href={project.sourceUrl} target="_blank" rel="noopener noreferrer">
                    {i18n(I18nKey.projectsSource)} <span aria-hidden="true">↗</span>
                </a>
            )}
        </div>
    </div>
</article>
