---
const displacementMap = [
    "<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' preserveAspectRatio='none'>",
    "<defs>",
    "<radialGradient id='g' cx='50%' cy='50%' r='72%'>",
    "<stop offset='0.58' stop-color='rgb(128,128,128)'/>",
    "<stop offset='0.78' stop-color='rgb(128,128,128)'/>",
    "<stop offset='0.94' stop-color='rgb(188,188,188)'/>",
    "<stop offset='1' stop-color='rgb(80,80,80)'/>",
    "</radialGradient>",
    "</defs>",
    "<rect width='100' height='100' fill='url(#g)'/>",
    "</svg>",
].join("");

const mapHref = `data:image/svg+xml,${encodeURIComponent(displacementMap)}`;
---

<svg
    id="lg-nav-filter"
    width="0"
    height="0"
    aria-hidden="true"
    focusable="false"
    style="position:absolute;overflow:hidden;pointer-events:none"
>
    <filter
        id="lg-nav-refraction"
        x="0"
        y="0"
        width="100%"
        height="100%"
        color-interpolation-filters="sRGB"
    >
        <feImage href={mapHref} result="lg-map" preserveAspectRatio="none"></feImage>
        <feDisplacementMap
            in="SourceGraphic"
            in2="lg-map"
            scale="16"
            xChannelSelector="R"
            yChannelSelector="R"
        ></feDisplacementMap>
    </filter>
</svg>

<script is:inline>
try {
    const isChromium = "userAgentData" in navigator;
    const canRefract = CSS.supports("backdrop-filter", "url(#lg-nav-refraction)") ||
        CSS.supports("-webkit-backdrop-filter", "url(#lg-nav-refraction)");
    if (isChromium && canRefract && !window.matchMedia("(pointer: coarse)").matches) {
        document.documentElement.classList.add("lg-refract");
    }
} catch (_) {}
</script>
