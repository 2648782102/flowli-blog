---
import type { CollectionEntry } from "astro:content";

import PostCard from "@components/post/postCard.astro";


const { page } = Astro.props;
---

<div class="post-index">
    {page.data.map((entry: CollectionEntry<"posts">) => (
        <PostCard
            entry={entry}
        ></PostCard>
    ))}
</div>
