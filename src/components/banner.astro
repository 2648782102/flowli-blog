---
// LETTERPRESS 视觉重写：全屏横幅 / 壁纸轮播已移除。
// 这里只保留 wallpaper.ts、reveal 与 Swup 逻辑所需的 DOM 锚点，
// 元素本身由 editorial.css 隐藏，避免任何布局或图片加载副作用。
interface Props {
    config?: unknown;
    isHomePage?: boolean;
    class?: string;
}
const { class: className } = Astro.props;
---

<div id="banner-wrapper" class:list={["hidden", className]} aria-hidden="true">
    <div id="banner"></div>
</div>

<script>
    // 轮播容器已不存在，提供一个空实现，避免 wallpaper.ts 调用旧句柄时报错
    window.initBannerCarousel = () => {};
</script>
