---
import { Icon } from "astro-icon/components";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { getFileDirFromPath, getPostUrl } from "@utils/url";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import ImageWrapper from "@components/common/imageWrapper.astro";


interface Props {
    class?: string;
    entry: CollectionEntry<"posts">;
    style?: string;
}

const { entry, class: className, style } = Astro.props;
const postUrl = getPostUrl(entry);
const { title, published, description, cover, tags, category, pinned } = entry.data;
const hasCover = cover !== undefined && cover !== null && cover !== "";
const { remarkPluginFrontmatter } = await render(entry);
const imageBaseDir = getFileDirFromPath(entry.filePath || "");
const publishedDate = new Date(published!).toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
});
const categoryLabel = Array.isArray(category) ? category.join(" / ") : category;
const tagLabel = tags && tags.length > 0 ? tags.map((tag) => `#${tag}`).join(" ") : "未分类";
const excerpt = description || remarkPluginFrontmatter.excerpt;
---

<article class:list={["post-row", className]} style={style}>
    <div class="post-row-main">
        <a href={postUrl} class="post-row-title">
            {pinned && <Icon name="mdi:pin" class="inline w-4 h-4 mr-1.5 -translate-y-0.5 text-(--navy)" aria-label="置顶" />}
            {title}
        </a>
        {excerpt && <p class="post-row-description">{excerpt}</p>}
        <div class="post-row-meta">
            <span>{categoryLabel || tagLabel}</span>
            <span>{remarkPluginFrontmatter.words} {i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}</span>
            <span>{remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</span>
        </div>
    </div>
    <time class="post-row-date" datetime={new Date(published!).toISOString()}>{publishedDate}</time>
    {!hasCover && (
        <a href={postUrl} class="post-row-arrow" aria-label={`阅读 ${title}`}>
            阅读全文
            <Icon name="material-symbols:arrow-forward-rounded" />
        </a>
    )}
    {hasCover && (
        <a href={postUrl} aria-label={title} class="post-row-cover">
            <ImageWrapper src={cover} basePath={imageBaseDir} alt={`${title} 的封面`} loading="lazy"></ImageWrapper>
        </a>
    )}
</article>
